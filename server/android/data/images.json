  {
    "id": "gsi-android-14-arm64",
    "name": "GSI Android 14 (ARM64)",
    "platform": "android",
    "androidVersion": "14",
    "apiLevel": 34,
    "architecture": "arm64",
    "variant": "gsi",
    "formFactors": ["phone", "tablet_large", "headless"],
    "googleServices": false,
    "support": "experimental",
    "userSupplied": true,
    "capabilities": { "touch": true, "keyboard": true, "adb": true, "root": true },
    "engines": [
      {
        "runtime": "qemu",
        "boot": "qemu-uefi",
        "requiresKvm": false,
        "gpu": "none",
        "preference": 10,
        "support": "experimental",
        "source": { "kind": "pve-disk", "volid": "local:iso/gsi-14-arm64.img" },
        "notes": "ARM64 on an x86 host means full TCG translation - no KVM, no GPU. Boots in minutes, runs at a small fraction of native speed. Fine for a headless instrumentation run, painful for anything interactive."
      },
      {
        "runtime": "physical-adb",
        "boot": "device",
        "requiresKvm": false,
        "gpu": "none",
        "preference": 100,
        "support": "supported",
        "source": { "kind": "device" },
        "notes": "Preferred: satisfy ARM64 requests with a real ARM64 device on a node."
      }
    ],
    "notes": "The cluster is x86-64. This image exists to prove the ARM path: the scheduler will steer an ARM64 request to a physical device when one is free, and only fall back to TCG when explicitly allowed."
  },
